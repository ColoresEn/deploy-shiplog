# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by the GitHub webhook (never expose with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
GITHUB_WEBHOOK_SECRET=

# Public origin used in magic-link redirects and the RSS feed
NEXT_PUBLIC_SITE_URL=http://localhost:3000
